---
import { session } from '../data/session';

const pageUrl = new URL(import.meta.env.BASE_URL + '/', Astro.site).href.replace(/\/{2,}$/, '/');
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<section class="section closing">
  <div class="container">
    <blockquote class="quote">
      <p>In the AI era, everyone will have access to the same models.</p>
      <p>The differentiator is no longer the model.</p>
      <p class="quote__punch">It’s the architecture around it.</p>
    </blockquote>

    <div class="share card">
      <h2 class="share__title">Take it with you</h2>
      <p class="share__text">
        The protocol, the six rules and the three worked examples, all copy-and-paste ready. Share it with anyone
        wrestling with the same problem.
      </p>
      <div class="share__actions">
        <span class="share__url" id="page-url">{pageUrl}</span>
        <button class="btn btn--small" type="button" data-copy="#page-url">
          <span data-copy-label>Copy link</span>
        </button>
        <a class="btn btn--small" href={linkedInShareUrl} target="_blank" rel="noopener">
          <svg class="share__icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
            ></path>
          </svg>
          Share on LinkedIn
        </a>
        <a class="btn btn--small" href={session.repo} target="_blank" rel="noopener">View on GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-top: 4rem;
  }

  .quote {
    margin: 0 0 2.5rem;
    padding: 0;
    text-align: center;
    font-size: clamp(1.25rem, 3vw, 1.85rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .quote p {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
  }

  .quote__punch {
    color: var(--text);
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .share {
    background: linear-gradient(160deg, var(--bg-card), color-mix(in srgb, var(--accent) 7%, var(--bg-card)));
    padding: 1.5rem 1.6rem;
  }

  .share__title {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .share__text {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1rem;
    max-width: 42rem;
  }

  .share__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .share__icon {
    color: var(--accent);
  }

  .share__url {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    overflow-wrap: anywhere;
  }
</style>
